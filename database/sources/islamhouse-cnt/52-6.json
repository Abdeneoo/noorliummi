{"data":[{"id":81886,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u0648\u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0635\u0627\u0639 \u0643\u064a\u0644\u0648\u0627\u0646 \u0648\u0623\u0631\u0628\u0639\u0648\u0646 \u063a\u0631\u0627\u0645\u064b\u0627 \u0645\u0646 \u0627\u0644\u0628\u064f\u0631 \u0627\u0644\u062c\u064a\u0651\u0650\u062f\u060c \u0647\u0630\u0627 \u0647\u0648 \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0635\u0627\u0639 \u0627\u0644\u0646\u0628\u0648\u064a \u0627\u0644\u0630\u064a \u0642\u062f\u0631 \u0628\u0647 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0651\u0645 \u0627\u0644\u0641\u0637\u0631\u0629.","page_number":6,"transes":{"ur":"\u0635\u0627\u0639 \u06a9\u06cc \u0645\u0642\u062f\u0627\u0631 \u0627\u0686\u06be\u06d2 \u0642\u0633\u0645 \u06a9\u06d2 \u06af\u0646\u062f\u0645 \u0633\u06d2 \u062f\u0648 \u06a9\u0644\u0648 \u0686\u0627\u0644\u06cc\u0633 \u06af\u0631\u0627\u0645 (kg 2.40) \u06c1\u06d2\u060c \u06cc\u06c1\u06cc \u0635\u0627\u0639 \u0646\u0628\u0648\u06cc \u06a9\u06cc \u0645\u0642\u062f\u0627\u0631 \u06c1\u06d2 \u062c\u0633 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u0646\u0628\u06cc\ufdfa \u0646\u06d2 \u0641\u0637\u0631\u06c1 (\u0641\u0637\u0631\u0627\u0646\u06c1) \u06a9\u06cc \u0645\u0642\u062f\u0627\u0631 \u0645\u0642\u0631\u0631 \u06a9\u06cc \u06c1\u06d2\u06d4"}},{"id":81887,"tag":"p","type":"paragraph","splitted":1,"split_group":20732,"original_text":"\u0648\u064a\u062c\u0628 \u0625\u062e\u0631\u0627\u062c \u0627\u0644\u0641\u0637\u0631\u0629 \u0642\u0628\u0644 \u0635\u0644\u0627\u0629 \u0627\u0644\u0639\u064a\u062f \u0648\u0627\u0644\u0623\u0641\u0636\u0644 \u0625\u062e\u0631\u0627\u062c\u0647\u0627 \u064a\u0648\u0645 \u0627\u0644\u0639\u064a\u062f \u0642\u0628\u0644 \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u0648\u062a\u062c\u0632\u0626 \u0642\u0628\u0644\u0647 \u0628\u064a\u0648\u0645 \u0623\u0648 \u064a\u0648\u0645\u064a\u0646 \u0641\u0642\u0637\u060c \u0648\u0644\u0627 \u062a\u062c\u0632\u0626 \u0628\u0639\u062f \u0635\u0644\u0627\u0629 \u0627\u0644\u0639\u064a\u062f\u061b \u0644\u062d\u062f\u064a\u062b \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 - \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 - \u0623\u0646 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0651\u0645: \u0641\u0631\u0636 \u0632\u0643\u0627\u0629 \u0627\u0644\u0641\u0637\u0631 \u0637\u064f\u0647\u0631\u0629 \u0644\u0644\u0635\u0627\u0626\u0645 \u0645\u0646 \u0627\u0644\u0644\u063a\u0648 \u0648\u0627\u0644\u0631\u0641\u062b \u0648\u0637\u0639\u0645\u0629 \u0644\u0644\u0645\u0633\u0627\u0643\u064a\u0646\u060c \u0641\u0645\u0646 \u0623\u062f\u0651\u064e\u0627\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u0635\u0644\u0627\u0629 \u0641\u0647\u064a \u0632\u0643\u0627\u0629 \u0645\u0642\u0628\u0648\u0644\u0629\u060c \u0648\u0645\u064e\u0646 \u0623\u062f\u0651\u064e\u0627\u0647\u0627 \u0628\u0639\u062f \u0627\u0644\u0635\u0644\u0627\u0629 \u0641\u0647\u064a \u0635\u062f\u0642\u0629 \u0645\u0646 \u0627\u0644\u0635\u062f\u0642\u0627\u062a. \u0631\u0648\u0627\u0647 \u0623\u0628\u0648\u062f\u0627\u0648\u062f \u0648\u0627\u0628\u0646 \u0645\u0627\u062c\u0647.","page_number":6,"transes":{"ur":"\u0635\u062f\u0642\u06c2 \u0641\u0637\u0631 \u0646\u0645\u0627\u0632\u0650 \u0639\u06cc\u062f \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0646\u06a9\u0627\u0644\u0646\u0627 \u0648\u0627\u062c\u0628 \u06c1\u06d2\u060c \u0627\u0641\u0636\u0644 \u06cc\u06c1 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633\u06d2 \u0639\u06cc\u062f \u06a9\u06d2 \u062f\u0646 \u0646\u0645\u0627\u0632\u0650 \u0639\u06cc\u062f \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0646\u06a9\u0627\u0644\u0627 \u062c\u0627\u0626\u06d2\u060c \u0639\u06cc\u062f \u0633\u06d2 \u0627\u06cc\u06a9 \u06cc\u0627 \u062f\u0648 \u062f\u0646 \u067e\u06c1\u0644\u06d2 \u0628\u06be\u06cc \u0646\u06a9\u0627\u0644\u06