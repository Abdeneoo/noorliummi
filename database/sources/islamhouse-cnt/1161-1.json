{"data":[{"id":1521082,"tag":"h1","type":"title","splitted":0,"split_group":0,"original_text":"\u0645\u0646 \u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0635\u064a\u0627\u0645","page_number":1,"transes":{"ur":"\u0631\u0648\u0632\u06d2 \u06a9\u06d2 \u0628\u0639\u0636 \u0627\u062d\u06a9\u0627\u0645","id":"BEBERAPA HUKUM TERKAIT PUASA"}},{"id":1521083,"tag":"h1","type":"title","splitted":0,"split_group":0,"original_text":"\u0627\u0644\u0645\u0628\u062d\u062b \u0627\u0644\u0623\u0648\u0644","page_number":1,"transes":{"ur":"\u067e\u06c1\u0644\u0627 \u0645\u0628\u062d\u062b","id":"Pembahasan Ke-1"}},{"id":1521084,"tag":"h1","type":"title","splitted":0,"split_group":0,"original_text":"\u0645\u0639\u0646\u0649 \u0627\u0644\u0635\u0648\u0645\u060c \u0648\u0648\u062c\u0648\u0628 \u0635\u064a\u0627\u0645 \u0631\u0645\u0636\u0627\u0646","page_number":1,"transes":{"ur":"\u0635\u0648\u0645 \u06a9\u0627 \u0645\u0639\u0646\u06cc\u060c \u0627\u0648\u0631 \u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u0631\u0648\u0632\u06d2 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06cc \u0641\u0631\u0636\u06cc\u062a","id":"Makna Puasa dan Kewajiban Puasa Ramadan"}},{"id":1521085,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u0623\u0648\u0644\u0627\u064b: \u0645\u0639\u0640\u0640\u0640\u0640\u0640\u0640\u0646\u0649 \u0627\u0644\u0635\u0640\u0640\u0640\u0640\u0640\u0648\u0645:","page_number":1,"transes":{"ur":"1- \u0635\u0648\u0645 \u06a9\u0627 \u0645\u0639\u0646\u06cc:","id":"Pertama: Makna Puasa"}},{"id":1521086,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u0627\u0644\u0640\u0635\u0640\u0640\u064a\u0640\u0640\u0627\u0645 \u0647\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0648: \u0627\u0644\u062a\u0639\u0640\u0640\u0640\u0628\u0640\u0640\u062f \u0644\u0644\u0647 \u062a\u0639\u0640\u0640\u0627\u0644\u0649 \u0628\u0627\u0644\u0625\u0645\u0633\u0640\u0640\u0627\u0643 \u0639\u0646 \u0627\u0644\u0645\u0641\u0637\u0640\u0640\u0640\u0640\u0640\u0640\u0631\u0627\u062a \u0645\u0646 \u0637\u0644\u0648\u0639 \u0627\u0644\u0641\u062c\u0640\u0640\u0631 \u0625\u0644\u0649 \u063a\u0640\u0640\u0631\u0648\u0628 \u0627\u0644\u0634\u0645\u0633.","page_number":1,"transes":{"ur":"\u0635\u06cc\u0627\u0645 (\u0631\u0648\u0632\u06c1): \u0628\u0637\u0648\u0631 \u0639\u0628\u0627\u062f\u062a \u0637\u0644\u0648\u0639 \u0641\u062c\u0631 \u0633\u06d2 \u063a\u0631\u0648\u0628 \u0622\u0641\u062a\u0627\u0628 \u062a\u06a9 \u0645\u0641\u0637\u0631\u0627\u062a (\u062c\u0646 \u0686\u06cc\u0632\u0648\u06ba \u0633\u06d2 \u0631\u0648\u0632\u06c1 \u0679\u0648\u0679 \u062c\u0627\u06d3) \u0633\u06d2 \u0628\u0627\u0632 \u0631\u06c1\u0646\u0627\u06d4","id":"Puasa adalah ibadah kepada Allah Ta'ala dengan menahan diri dari hal-hal yang membatalkan puasa mulai dari terbit fajar hingga terbenam matahari."}},{"id":1521087,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u062b\u0627\u0646\u064a\u0627\u064b: \u0648\u062c\u0648\u0628 \u0635\u064a\u0627\u0645 \u0631\u0645\u0636\u0627\u0646:","page_number":1,"transes":{"ur":"2- \u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u0631\u0648\u0632\u06d2 \u06a9\u06cc \u0641\u0631\u0636\u06cc\u062a:","id":"Kedua: Kewajiban Puasa Ramadan"}},{"id":1521088,"tag":"p","type":"paragraph","splitted":1,"split_group":7,"original_text":"\u0635\u064a\u0627\u0645 \u0631\u0645\u0636\u0627\u0646 \u0631\u0643\u0646 \u0645\u0646 \u0623\u0631\u0643\u0627\u0646 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0627\u0644\u062a\u064a \u0644\u0627 \u064a\u0642\u0648\u0645 \u062f\u064a\u0646 \u0627\u0644\u0645\u0633\u0644\u0645 \u0625\u0644\u0627 \u0628\u0647\u0627.  \u0648\u0627\u0644\u0635\u064a\u0627\u0645 \u0641\u0631\u064a\u0636\u0629 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0645\u0645 \u0648\u0625\u0646 \u0627\u062e\u062a\u0644\u0641\u062a \u0643\u064a\u0641\u064a\u062a\u0647 \u0648\u0648\u0642\u062a\u0647\u061b \u0643\u0645\u0627 \u0642\u0627\u0644 \u062a\u0639\u0627\u0644\u0649: (\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0643\u064f\u062a\u0650\u0628\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064f \u0671\u0644\u0635\u0651\u0650\u064a\u064e\u0627\u0645\u064f \u0643\u064e\u0645\u064e\u0627 \u0643\u064f\u062a\u0650\u0628\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650\u0643\u064f\u0645\u06e1 \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u062a\u0651\u064e\u0642\u064f\u0648\u0646\u064e) (\u0627\u0644\u0628\u0642\u0631\u0629: \u0661\u0668\u0663)\u060c \u0648(\u0643\u062a\u0628) \u0628\u0645\u0639\u0646\u0649 \u0641\u064f\u0631\u0636.","page_number":1,"transes":{"ur":"\u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u0631\u0648\u0632\u0631\u06c1 \u062f\u06cc\u0646 \u0627\u0633\u0644\u0627\u0645 \u06a9\u0627 \u0627\u06cc\u06a9 \u0631\u06a9\u0646 \u06c1\u06d2 \u062c\u0633 \u06a9\u06d2 \u0628\u063a\u06cc\u0631 \u0645\u0633\u0644\u0645\u0627\u0646 \u06a9\u0627 \u062f\u06cc\u0646 \u0642\u0627\u0626\u0645 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u062a\u0627\u06d4 \u0631\u0648\u0632\u06c1 \u062a\u0645\u0627\u0645 \u0627\u0645\u062a\u0648\u06ba \u067e\u0631 \u0641\u0631\u0636 \u0631\u06c1\u0627 \u06c1\u06d2 \u0627\u06af\u0631\u0686\u06c1 \u0627\u0633 \u06a9\u06cc \u06a9\u06cc\u0641\u06cc\u062a \u0627\u0648\u0631 \u0648\u0642\u062a \u0645\u062e\u062a\u0644\u0641 \u0631\u06c1\u0627 \u06c1\u0648\u061b \u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u0627\u0644\u0644\u06c1 \u062a\u0639\u0627\u0644\u06cc \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627: (\u0627\u06d2 \u0644\u0648\u06af\u0648 \u062c\u0648 \u0627\u06cc\u0645\u0627\u0646 \u0644\u0627\u0626\u06d2 \u06c1\u0648\u060c \u062a\u0645 \u067e\u0631 \u0631\u0648\u0632\u06d2 \u0641\u0631\u0636 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba \u062c\u0633 \u0637\u0631\u062d \u062a\u0645 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0644\u0648\u06af\u0648\u06ba \u067e\u0631 \u0641\u0631\u0636 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2 \u062a\u06be\u06d2 \u062a\u0627\u06a9\u06c1 \u062a\u0645 \u067e\u0631\u06c1\u06cc\u0632\u06af\u0627\u0631 \u0628\u0646 \u062c\u0627\u0624)\u06d4 (\u0627\u0644\u0628\u0642\u0631\u06c3: 183) (\u06a9\u062a\u0628) \u06a9\u0627 \u0645\u0639\u0646\u0649 \u0641\u0631\u0636 \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4","id":"Puasa Ramadan adalah salah satu rukun Islam yang tidak dapat dipisahkan dari agama seorang muslim. Ibadah puasa diwajibkan kepada seluruh umat manusia, meskipun tata cara dan waktunya berbeda-beda, sebagaimana firman Allah Ta'ala, \"Wahai orang-orang yang beriman! Diwajibkan atas kamu berpuasa sebagaimana diwajibkan atas orang-orang sebelum kamu agar kamu bertakwa.\" (QS. Al-Baqarah: 183) Kata \"kutiba\" bermakna: diwajibkan."}},{"id":1521092,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u0648\u0642\u062f \u062f\u0644 \u0639\u0644\u0649 \u0648\u062c\u0648\u0628\u0647 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u0633\u0646\u0629 \u0648\u0627\u0644\u0625\u062c\u0640\u0645\u0627\u0639:","page_number":1,"transes":{"ur":"\u0627\u0633 \u06a9\u06d2 \u0648\u062c\u0648\u0628 \u067e\u0631 \u06a9\u062a\u0627\u0628 \u0648 \u0633\u0646\u062a \u0627\u0648\u0631 \u0627\u062c\u0645\u0627\u0639 \u062f\u0644\u06cc\u0644 \u06c1\u06cc\u06ba\u06d4","id":"Kewajiban puasa Ramadan telah ditetapkan berdasarkan Al-Qur`an, Sunnah, dan ijmak."}},{"id":1521093,"tag":"p","type":"paragraph","splitted":1,"split_group":9,"original_text":"\u2022 \u0641\u0623\u0645\u0627 \u0627\u0644\u0643\u062a\u0627\u0628: \u0641\u0642\u0648\u0644\u0647 \u062a\u0639\u0627\u0644\u0649: (\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0643\u064f\u062a\u0650\u0628\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064f \u0671\u0644\u0635\u0651\u0650\u064a\u064e\u0627\u0645\u064f \u0643\u064e\u0645\u064e\u0627 \u0643\u064f\u062a\u0650\u0628\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650\u0643\u064f\u0645\u06e1 \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u062a\u0651\u064e\u0642\u064f\u0648\u0646\u064e 183 \u0623\u064e\u064a\u0651\u064e\u0627\u0645\u0657\u0627 \u0645\u0651\u064e\u0639\u06e1\u062f\u064f\u0648\u062f\u064e\u0670\u062a\u0656\u06da) (\u0627\u0644\u0628\u0642\u0631\u0629: \u0661\u0668\u0663 - \u0661\u0668\u0664).","page_number":1,"transes":{"ur":"\u2022 \u062c\u06c1\u0627\u06ba \u062a\u06a9 \u0642\u0631\u0622\u0646 \u06a9\u0627 \u062a\u0639\u0644\u0642 \u06c1\u06d2 \u062a\u0648\u0627\u0644\u0644\u06c1 \u062a\u0628\u0627\u0631\u06a9 \u0648\u062a\u0639\u0627\u0644\u06cc \u06a9\u0627 \u0641\u0631\u0645\u0627\u0646 \u06c1\u06d2: (\u0627\u06d2 \u0644\u0648\u06af\u0648 \u062c\u0648 \u0627\u06cc\u0645\u0627\u0646 \u0644\u0627\u0626\u06d2 \u06c1\u0648\u060c \u062a\u0645 \u067e\u0631 \u0631\u0648\u0632\u06d2 \u0641\u0631\u0636 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2 \u06c1\u06cc\u06ba \u062c\u0633 \u0637\u0631\u062d \u062a\u0645 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0644\u0648\u06af\u0648\u06ba \u067e\u0631 \u0641\u0631\u0636 \u06a9\u06cc\u06d2 \u06af\u0626\u06d2 \u062a\u06be\u06d2 \u062a\u0627\u06a9\u06c1 \u062a\u0645 \u067e\u0631\u06c1\u06cc\u0632\u06af\u0627\u0631 \u0628\u0646 \u062c\u0627\u0624\u06d4 \u0686\u0646\u062f \u06af\u0646\u06d2 \u06c1\u0648\u0626\u06d2 \u062f\u0646) [\u0633\u0648\u0631\u06c3 \u0627\u0644\u0628\u0642\u0631\u06c3 : 183 - 184]\u06d4","id":"Adapun dalil dari Al-Qur`an, yaitu firman Allah Ta'ala, \"Wahai orang-orang yang beriman! Diwajibkan atas kamu berpuasa sebagaimana diwajibkan atas orang-orang sebelum kamu agar kamu bertakwa. (Yaitu) beberapa hari yang telah ditentukan.\" (QS. Al-Baqarah: 183-184)"}},{"id":1521097,"tag":"p","type":"paragraph","splitted":1,"split_group":10,"original_text":"\u2022 \u0648\u0623\u0645\u0640\u0627 \u0627\u0644\u0633\u0646\u0629: \u0641\u0642\u0648\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645: \u00ab\u0628\u0646\u064a \u0627\u0644\u0625\u0633\u0640\u0644\u0627\u0645 \u0639\u0644\u0649 \u062e\u0640\u0645\u0633: \u0634\u0647\u0627\u062f\u0629 \u0623\u0646 \u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627 \u0627\u0644\u0644\u0647\u060c \u0648\u0623\u0646 \u0645\u062d\u0645\u062f\u064b\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647\u060c \u0648\u0625\u0642\u0627\u0645 \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u0648\u0625\u064a\u062a\u0627\u0621 \u0627\u0644\u0632\u0643\u0627\u0629\u060c \u0648\u0635\u0648\u0645 \u0631\u0645\u0636\u0627\u0646\u060c \u0648\u062d\u062c \u0627\u0644\u0628\u064a\u062a\u00bb ([1]). \u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647\u060c \u0623\u062e\u0631\u062c\u0647 \u0627\u0644\u0628\u062e\u0627\u0631\u064a \u0628\u0631\u0642\u0645 8 (1\/11)\u060c \u0648\u0645\u0633\u0644\u0645 \u0628\u0631\u0642\u0645 16 (1\/34).","page_number":1,"transes":{"ur":"\u2022 \u062c\u06c1\u0627\u06ba \u062a\u06a9 \u062d\u062f\u06cc\u062b \u06a9\u06cc \u0628\u0627\u062a \u06c1\u06d2 \u062a\u0648\u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u0631\u0633\u0648\u0644 \ufdfa \u06a9\u0627 \u0641\u0631\u0645\u0627\u0646 \u06c1\u06d2: \"\u0627\u0633\u0644\u0627\u0645 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0627\u0646\u0686 \u0686\u06cc\u0632\u0648\u06ba \u067e\u0631 \u06c1\u06d2: \u0627\u0633 \u0628\u0627\u062a \u06a9\u06cc \u06af\u0648\u0627\u06c1\u06cc \u062f\u06cc\u0646\u0627 \u06a9\u06c1 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u0633\u0648\u0627 \u06a9\u0648\u0626\u06cc \u0633\u0686\u0627 \u0645\u0639\u0628\u0648\u062f \u0646\u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0628\u06d2 \u0634\u06a9 \u0645\u062d\u0645\u062f \u0635\u0644\u06cc \u0627\u0644\u0644\u06c1 \u0639\u0644\u06cc\u06c1 \u0648\u0633\u0644\u0645 \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u0633\u0686\u06d2 \u0631\u0633\u0648\u0644 \u06c1\u06cc\u06ba\u060c \u0646\u0645\u0627\u0632 \u0642\u0627\u0626\u0645 \u06a9\u0631\u0646\u0627\u060c \u0632\u06a9\u0648\u0670\u06c3 \u0627\u062f\u0627 \u06a9\u0631\u0646\u0627\u060c \u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u0631\u0648\u0632\u06d2 \u0631\u06a9\u06be\u0646\u0627 \u0627\u0648\u0631 \u062e\u0627\u0646\u06c1 \u06a9\u0639\u0628\u06c1 \u06a9\u0627 \u062d\u062c \u06a9\u0631\u0646\u0627\"\u06d4 ([1]) \u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647\u060c \u0628\u062e\u0627\u0631\u06cc \u062d\u062f\u06cc\u062b (8) (1\/11)\u06d4 \u0645\u0633\u0644\u0645 \u062d\u062f\u06cc\u062b (16) (1\/34)\u06d4","id":"Adapun dalil dari Sunnah adalah sabda Rasulullah \ufdfa, \"Islam dibangun di atas lima pilar; syahadat 'L\u0101 il\u0101ha illall\u0101h Mu\u1e25ammad ras\u016blull\u0101h', mendirikan salat, menunaikan zakat, berpuasa Ramadan, dan berhaji ke Baitullah.\" ([1]) Muttafaq 'alaihi. Diriwayatkan oleh Bukhari no. 8 (1\/11) dan Muslim no. 16 (1\/34)."}},{"id":1521100,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u2022 \u0648\u0623\u0645\u0640\u0627 \u0627\u0644\u0625\u062c\u0640\u0645\u0627\u0639: \u0641\u0642\u0640\u062f \u0623\u062c\u0640\u0645\u0639 \u0627\u0644\u0645\u0633\u0644\u0645\u0640\u0648\u0646 \u0639\u0644\u0649 \u0648\u062c\u0648\u0628 \u0635\u0648\u0645\u0640\u0647\u060c \u0648\u0623\u0646 \u0645\u0646 \u0623\u0646\u0643\u0631 \u0648\u062c\u0640\u0648\u0628 \u0635\u064a\u0627\u0645\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0647 \u0641\u0647\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0648 \u0643\u0627\u0641\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0631.","page_number":1,"transes":{"ur":"\u0627\u0633 \u06a9\u06d2 \u0648\u062c\u0648\u0628 \u067e\u0631 \u0645\u0633\u0644\u0645\u0627\u0646\u0648\u06ba \u06a9\u0627 \u0627\u062c\u0645\u0627\u0639 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u062c\u0648 \u0634\u062e\u0635 \u0627\u0633 \u06a9\u06d2 \u0648\u062c\u0648\u0628 \u06a9\u0627 \u0627\u0646\u06a9\u0627\u0631 \u06a9\u0631\u06d2 \u0648\u06c1 \u06a9\u0627\u0641\u0631 \u06c1\u06d2\u06d4","id":"Adapun dalil dari ijmak maka para ulama telah sepakat bahwa puasa Ramadan hukumnya wajib. Barang siapa yang mengingkari kewajibannya, maka ia telah kafir."}}],"meta":{"total_pages":10}}