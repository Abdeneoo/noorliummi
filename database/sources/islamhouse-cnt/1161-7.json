631\u064a\u0646 \u0645\u062a\u062a\u0627\u0628\u0639\u064a\u0646\u060c \u0641\u0625\u0646 \u0644\u0645 \u064a\u0633\u062a\u0637\u0639 \u0623\u0646 \u064a\u0635\u0648\u0645 \u0634\u0647\u0631\u064a\u0646 \u0645\u062a\u062a\u0627\u0628\u0639\u064a\u0646 \u0623\u0637\u0639\u0645 \u0633\u062a\u064a\u0646 \u0645\u0633\u0643\u064a\u0646\u0627\u064b\u060c \u0644\u0643\u0644 \u0645\u0633\u0643\u064a\u0646 \u0646\u0635\u0641 \u0635\u0627\u0639 \u0645\u0646 \u0628\u0631 \u0623\u0648 \u063a\u064a\u0631\u0647 \u0645\u0645\u0627 \u064a\u0643\u0648\u0646 \u0637\u0639\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0627\u0645\u0627\u064b \u0644\u0644\u0640\u0628\u0640\u0640\u0640\u0640\u0644\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u062f.","page_number":7,"transes":{"ur":"\u062c\u0628 \u0628\u06be\u06cc \u06a9\u0633\u06cc \u0646\u06d2 \u0631\u0645\u0636\u0627\u0646 \u06a9\u06d2 \u062f\u0646 \u0645\u06cc\u06ba \u062c\u0646\u0633\u06cc \u0645\u0644\u0627\u067e \u06a9\u06cc\u0627 \u062a\u0648 \u0627\u0633 \u06a9\u0627 \u0631\u0648\u0632\u06c1 \u0628\u0627\u0637\u0644 \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u060c \u0627\u0648\u0631 \u0627\u0633 \u067e\u0631 \u0644\u0627\u0632\u0645 \u06c1\u06d2 \u06a9\u06c1 \u062f\u0646 \u06a9\u06d2 \u0628\u0627\u0642\u06cc \u062d\u0635\u06d2 \u0645\u06cc\u06ba \u06a9\u0686\u06be \u0646\u06c1 \u06a9\u06be\u0627\u0626\u06d2\u060c \u0627\u0633 \u067e\u0631 \u062a\u0648\u0628\u06c1 \u0627\u0648\u0631 \u0627\u0633\u062a\u063a\u0641\u0627\u0631 \u06a9\u0631\u0646\u0627 \u0648\u0627\u062c\u0628 \u06c1\u06d2\u060c \u0627\u0633 \u062f\u0646 \u06a9\u06cc \u0642\u0636\u0627 \u06a9\u0631\u06d2 \u062c\u0633 \u062f\u0646 \u0627\u0633 \u0646\u06d2 \u062c\u0645\u0627\u0639 \u06a9\u06cc\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u0627\u0633 \u067e\u0631 \u06a9\u0641\u0627\u0631\u06c1 \u0628\u06be\u06cc \u0648\u0627\u062c\u0628 \u06c1\u06d2\u060c \u062c\u0648 \u06a9\u06c1 \u06cc\u06c1 \u06c1\u06d2: \u0627\u06cc\u06a9 \u063a\u0644\u0627\u0645 \u0622\u0632\u0627\u062f \u06a9\u0631\u0646\u0627\u060c \u0627\u06af\u0631 \u063a\u0644\u0627\u0645 \u0646\u06c1 \u0645\u0644\u06d2 \u062a\u0648 \u0645\u0633\u0644\u0633\u0644 \u062f\u0648 \u0645\u0627\u06c1 \u06a9\u06d2 \u0631\u0648\u0632\u06d2 \u0631\u06a9\u06be\u06d2\u060c \u0627\u06af\u0631 \u062f\u0648 \u0645\u0627\u06c1 \u06a9\u06d2 \u0631\u0648\u0632\u06d2 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06cc \u0637\u0627\u0642\u062a \u0646\u06c1 \u06c1\u0648 \u062a\u0648 \u0633\u0627\u0679\u06be \u0645\u0633\u06a9\u06cc\u0646\u0648\u06ba \u06a9\u0648 \u06a9\u06be\u0627\u0646\u0627 \u06a9\u06be\u0644\u0627\u0626\u06d2\u060c \u06c1\u0631 \u0645\u0633\u06a9\u06cc\u0646 \u06a9\u0648 \u0646\u0635\u0641 \u0635\u0627\u0639 \u06af\u0646\u062f\u0645 \u06cc\u0627 \u0645\u0644\u06a9 \u06a9\u06d2 \u06a9\u06be\u0627\u0646\u06d2 \u06a9\u06cc \u0686\u06cc\u0632\u0648\u06ba \u0645\u06cc\u06ba \u0633\u06d2 \u062f\u06d2\u06d4","id":"Jika seseorang melakukan hubungan intim di siang hari bulan Ramadan, maka puasanya batal. Ia harus tetap menahan diri (berpuasa) untuk sisa hari tersebut, serta bertobat dan memohon ampun kepada Allah. Selain itu, ia wajib mengqada puasa untuk hari yang ia lakukan hubungan intim tersebut, dan juga wajib membayar kafarat, yaitu:\n1. Memerdekakan seorang budak.\n2. Jika tidak mampu, maka ia wajib berpuasa selama dua bulan berturut-turut.\n3. Jika tidak mampu berpuasa, maka ia wajib memberi makan kepada 60 orang miskin, dengan memberi setiap miskin setengah \u1e63\u0101' (kira-kira 2,5 kg) gandum atau sejenisnya yang merupakan makanan pokok di daerah tersebut."}},{"id":1521170,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"2- \u0625\u0646\u0632\u0627\u0644 \u0627\u0644\u0645\u0646\u064a \u0628\u0633\u0628\u0628 \u062a\u0642\u0628\u064a\u0644 \u0623\u0648 \u0645\u0628\u0627\u0634\u0631\u0629 \u0623\u0648 \u0627\u0633\u062a\u0645\u0646\u0627\u0621 \u0623\u0648 \u062a\u0643\u0631\u0627\u0631 \u0646\u0638\u0631:","page_number":7,"transes":{"ur":"2- \u0628\u0648\u0633 \u0648 \u06a9\u0646\u0627\u0631\u060c \u0645\u0628\u0627\u0634\u0631\u062a\u060c \u0645\u0634\u062a \u0632\u0646\u06cc \u06cc\u0627 \u0628\u0627\u0631 \u0628\u0627\u0631 \u062f\u06cc\u06a9\u06be\u0646\u06d2 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0645\u0646\u06cc \u06a9\u0627 \u0627\u0646\u0632\u0627\u0644\u06d4","id":"2) Mengeluarkan mani dengan sebab ciuman, cumbu, onani, atau pandangan yang berulang"}},{"id":1521171,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u0641\u0625\u0630\u0627 \u0623\u0646\u0632\u0644 \u0627\u0644\u0635\u0627\u0626\u0645 \u0628\u0633\u0628\u0628 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0641\u0633\u062f \u0635\u0648\u0645\u0647\u060c \u0648\u0639\u0644\u064a\u0647 \u0627\u0644\u0625\u0645\u0633\u0627\u0643\u060c \u0648\u064a\u0642\u0636\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645\u060c \u0648\u0644\u0627 \u0643\u0641\u0627\u0631\u0629 \u0639\u0644\u064a\u0647\u060c \u0648\u0644\u0643\u0646 \u0639\u0644\u064a\u0647 \u0627\u0644\u062a\u0648\u0628\u0629 \u0648\u0627\u0644\u0646\u062f\u0645 \u0648\u0627\u0644\u0627\u0633\u062a\u063a\u0641\u0627\u0631 \u0648\u0627\u0644\u0627\u0628\u062a\u0639\u0627\u062f \u0639\u0646 \u0647\u0630\u0647 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u062b\u064a\u0631\u0629 \u0644\u0644\u0634\u0647\u0648\u0629\u061b \u0644\u0623\u0646\u0647 \u0641\u064a \u0639\u0628\u0627\u062f\u0629 \u0639\u0638\u064a\u0645\u0629.","page_number":7,"transes":{"ur":"\u0627\u06af\u0631 \u0631\u0648\u0632\u06c1 \u062f\u0627\u0631 \u0627\u0646 \u0627\u0633\u0628\u0627\u0628 \u06a9\u06cc \u0648\u062c\u06c1 \u0633\u06d2 \u0645\u0646\u06cc \u062e\u0627\u0631\u062c \u06a9\u0631\u06d2 \u062a\u0648 \u0627\u0633 \u06a9\u0627 \u0631\u0648\u0632\u06c1 \u0641\u0627\u0633\u062f \u06c1\u0648 \u062c\u0627\u0626\u06d2 \u06af\u0627\u060c \u0627\u0648\u0631 \u0627\u0633 \u067e\u0631 \u0644\u0627\u0632\u0645 \u06c1\u06d2 \u06a9\u06c1 \u0631\u0648\u0632\u06c1 \u067e\u0648\u0631\u0627 \u06a9\u0631\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u062f\u0646 \u06a9\u06cc \u0642\u0636\u0627 \u06a9\u0631\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0627\u0633 \u067e\u0631 \u06a9\u0641\u0627\u0631\u06c1 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u060c \u0627\u0644\u0628\u062a\u06c1 \u062a\u0648\u0628\u06c1\u060c \u0646\u062f\u0627\u0645\u062a\u060c \u0627\u0633\u062a\u063a\u0641\u0627\u0631 \u0627\u0648\u0631 \u0627\u0646 \u0634\u06c1\u0648\u062a \u0627\u0646\u06af\u06cc\u0632 \u0686\u06cc\u0632\u0648\u06ba \u0633\u06d2 \u062f\u0648\u0631\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631 \u06a9\u0631\u0646\u0627 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2\u061b \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0648\u06c1 \u0627\u06cc\u06a9 \u0639\u0638\u06cc\u0645 \u0639\u0628\u0627\u062f\u062a \u0645\u06cc\u06ba \u0645\u0634\u063a\u0648\u0644 \u06c1\u06d2\u06d4","id":"Jika orang yang berpuasa mengeluarkan mani dengan salah satu sebab ini, maka puasanya batal. Namun ia tetap wajib menahan diri (berpuasa) pada sisa hari tersebut, kemudian mengqada puasa hari itu, dan tidak ada kafarat yang diwajibkan. Yang perlu ia lakukan adalah bertobat, menyesali perbuatan tersebut, memohon ampun kepada Allah, dan menjauhi hal-hal yang dapat membangkitkan syahwat, karena ia sedang menjalani ibadah yang sangat besar."}},{"id":1521172,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"3- \u0627\u0644\u0623\u0643\u0644 \u0648\u0627\u0644\u0634\u0631\u0628 \u0645\u062a\u0639\u0645\u062f\u0627\u064b.","page_number":7,"transes":{"ur":"3- \u062c\u0627\u0646 \u0628\u0648\u062c\u06be \u06a9\u0631 \u06a9\u06be\u0627\u0646\u0627 \u067e\u06cc\u0646\u0627\u06d4","id":"3) Makan dan minum dengan sengaja."}},{"id":1521173,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"4- \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u062f\u0645 \u0645\u0646 \u0627\u0644\u0635\u0627\u0626\u0645 \u0628\u062d\u062c\u0627\u0645\u0629 \u0623\u0648 \u0641\u0635\u062f \u0623\u0648 \u0633\u062d\u0628 \u062f\u0645 \u0644\u0644\u062a\u0628\u0631\u0639 \u0628\u0647.","page_number":7,"transes":{"ur":"4- \u0631\u0648\u0632\u06d2 \u06a9\u06cc \u062d\u0627\u0644\u062a \u0645\u06cc\u06ba \u0633\u06cc\u0646\u06af\u06cc \u06cc\u0627 \u0641\u0635\u062f \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06cc\u0627 \u0639\u0637\u06cc\u06c1 \u062f\u06cc\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062e\u0648\u0646 \u0646\u06a9\u0627\u0644\u0646\u0627\u06d4","id":"4) Mengeluarkan darah dari tubuh dengan bekam, terapi fa\u1e63du, atau donor darah."}},{"id":1521174,"tag":"p","type":"paragraph","splitted":1,"split_group":59,"original_text":"\u0648\u0627\u0644\u0623\u0635\u0644 \u0641\u064a \u0647\u0630\u0627 \u0642\u0648\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0641\u064a \u0627\u0644\u062d\u062c\u0627\u0645\u0629: \u00ab\u0623\u0641\u0637\u0631 \u0627\u0644\u062d\u0627\u062c\u0645 \u0648\u0627\u0644\u0645\u062d\u062c\u0648\u0645\u00bb ([13]). \u0623\u062e\u0631\u062c\u0647 \u0627\u0644\u0628\u062e\u0627\u0631\u064a \u0628\u0631\u0642\u0645 1937 (3\/33)\u060c \u0648\u0623\u062d\u0645\u062f \u0641\u064a \u0645\u0633\u0646\u062f\u0647 \u0628\u0631\u0642\u0645 26217 (43\/278).","page_number":7,"transes":{"ur":"\u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u0627\u0635\u0644 \u0646\u0628\u06cc \ufdfa \u06a9\u0627 \u06cc\u06c1 \u0627\u0631\u0634\u0627\u062f \u06c1\u06d2 \u062c\u0648 \u0633\u06cc\u0646\u06af\u06cc \u0644\u06af\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06c1\u06d2: \u2019\u2019\u0633\u06cc\u0646\u06af\u06cc  \u0644\u06af\u0627\u0646\u06d2 \u0627\u0648\u0631 \u0644\u06af\u0648\u0627\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u062f\u0648\u0646\u0648\u06ba \u06a9\u0627 \u0631\u0648\u0632\u06c1 \u0679\u0648\u0679 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u2018\u2018 ( [13] )\u06d4 (\u0635\u062d\u06cc\u062d \u0628\u062e\u0627\u0631\u06cc: \u06f1\u06f9\u06f3\u06f7\u060c \u0645\u0633\u0646\u062f \u0627\u062d\u0645\u062f: \u06f2\u06f6\u06f2\u06f1\u06f7)(43\/278).","id":"Dalil untuk hal ini adalah sabda Rasulullah \ufdfa mengenai bekam, \"Orang yang berbekam dan yang dibekam puasanya batal.\"([13]) HR. Bukhari no. 1937 (3\/33) dan Ahmad dalam Musnad-nya, no. 26217 (43\/278)."}},{"id":1521177,"tag":"p","type":"paragraph","splitted":1,"split_group":60,"original_text":"\u0642\u0627\u0644 \u0634\u064a\u062e \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0627\u0628\u0646 \u062a\u064a\u0645\u064a\u0629 \u0631\u062d\u0645\u0647 \u0627\u0644\u0644\u0647: \"\u0648\u0627\u0644\u0642\u0648\u0644 \u0628\u0623\u0646 \u0627\u0644\u062d\u062c\u0627\u0645\u0629 \u062a\u0641\u0637\u0631 \u0645\u0630\u0647\u0628 \u0623\u0643\u062b\u0631 \u0641\u0642\u0647\u0627\u0621 \u0627\u0644\u062d\u062f\u064a\u062b\u061b \u0643\u0623\u062d\u0645\u062f \u0628\u0646 \u062d\u0646\u0628\u0644\u060c \u0648\u0625\u0633\u062d\u0627\u0642 \u0628\u0646 \u0631\u0627\u0647\u0648\u064a\u0647\u060c \u0648\u0627\u0628\u0646 \u062e\u0632\u064a\u0645\u0629\u060c \u0648\u0627\u0628\u0646 \u0627\u0644\u0645\u0646\u0630\u0631\u060c \u0648\u063a\u064a\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0631\u0647\u0640\u0640\u0640\u0640\u0640\u0645\" ([14]).  \u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u062a\u0627\u0648\u0649 (25\/252).","page_number":7,"transes":{"ur":"\u0634\u06cc\u062e \u0627\u0644\u0627\u0633\u0644\u0627\u0645 \u0627\u0628\u0646 \u062a\u06cc\u0645\u06cc\u06c1 \u0631\u062d\u0645\u06c1 \u0627\u0644\u0644\u06c1 \u0641\u0631\u0645\u0627\u062a\u06d2 \u06c1\u06cc\u06ba: \"\u0627\u0648\u0631 \u06cc\u06c1 \u06a9\u06c1\u0646\u0627 \u06a9\u06c1 \u067e\u0686\u06be\u0646\u0627 \u0644\u06af\u0648\u0627\u0646\u06d2 \u0633\u06d2 \u0631\u0648\u0632\u06c1 \u0679\u0648\u0679 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u0627\u06a9\u062b\u0631 \u0641\u0642\u06c1\u0627\u0621 \u062d\u062f\u06cc\u062b \u062c\u06cc\u0633\u06d2 \u0627\u0645\u0627\u0645 \u0627\u062d\u0645\u062f \u0628\u0646 \u062d\u0646\u0628\u0644\u060c \u0627\u0633\u062d\u0627\u0642 \u0628\u0646 \u0631\u0627\u06c1\u0648\u06cc\u06c1\u060c \u0627\u0628\u0646 \u062e\u0632\u06cc\u0645\u06c1\u060c \u0627\u0628\u0646 \u0627\u0644\u0645\u0646\u0630\u0631 \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u06a9\u0627 \u0645\u0630\u06c1\u0628 \u06c1\u06d2\"\u06d4 [14] \u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u062a\u0627\u0648\u0649 (25\/252).","id":"Syekh Islam Ibnu Taimiyyah -ra\u1e25imahull\u0101h- berkata, \"Pendapat bahwa bekam membatalkan puasa adalah pendapat mayoritas ulama hadis, seperti Ahmad bin Hanbal, Is\u1e25\u0101q bin R\u0101hawaih, Ibnu Khuzaimah, Ibnu Al-Mun\u017cir, dan lainnya.\"([14]) Majm\u016b\u2019 Al-Fat\u0101w\u0101, (25\/252)"}},{"id":1521180,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"\u0648\u0623\u0645\u0627 \u062e\u0631\u0648\u062c \u0627\u0644\u062f\u0645 \u0628\u063a\u064a\u0631 \u0642\u0635\u062f \u0645\u0646 \u0627\u0644\u0635\u0627\u0626\u0645 \u0643\u0627\u0644\u0631\u0639\u0627\u0641\u060c \u0648\u062f\u0645 \u0627\u0644\u062c\u0631\u0627\u062d\u0629\u060c \u0648\u062e\u0644\u0639 \u0627\u0644\u0636\u0631\u0633\u060c \u0648\u0646\u062d\u0648\u0647 \u0641\u0625\u0646\u0647 \u0644\u0627 \u064a\u0624\u062b\u0631 \u0639\u0644\u0649 \u0627\u0644\u0635\u064a\u0627\u0645.","page_number":7,"transes":{"ur":"\u062c\u06c1\u0627\u06ba \u062a\u06a9 \u0628\u0644\u0627 \u0642\u0635\u062f \u0631\u0648\u0632\u06d2 \u062f\u0627\u0631 \u06a9\u06d2 \u062c\u0633\u0645 \u0633\u06d2 \u062e\u0648\u0646 \u0646\u06a9\u0644\u0646\u06d2 \u06a9\u06cc \u0628\u0627\u062a \u06c1\u06d2\u060c \u062c\u06cc\u0633\u06d2 \u0646\u06a9\u0633\u06cc\u0631\u060c \u0632\u062e\u0645 \u06a9\u0627 \u062e\u0648\u0646\u060c \u06cc\u0627 \u062f\u0627\u0646\u062a \u0646\u06a9\u0644\u0648\u0627\u0646\u06d2 \u0633\u06d2 \u062e\u0648\u0646 \u0646\u06a9\u0644\u0646\u0627\u060c \u062a\u0648 \u0627\u0633 \u0633\u06d2 \u0631\u0648\u0632\u06c1 \u0645\u062a\u0627\u062b\u0631 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u06af\u0627\u06d4","id":"Adapun darah yang keluar tanpa disengaja oleh orang yang berpuasa, seperti mimisan, darah luka operasi, pencabutan gigi, dan sejenisnya, maka hal itu tidak membatalkan puasa."}},{"id":1521181,"tag":"p","type":"paragraph","splitted":0,"split_group":0,"original_text":"5- \u0627\u0644\u0640\u0640\u062a\u0640\u0640\u0640\u0642\u0640\u0640\u064a\u0640\u0640\u0640\u0640\u0640\u0640\u0640\u0624:","page_number":7,"transes":{"ur":"5- \u0642\u06d2 \u06a9\u0631\u0646\u0627:","id":"5) Muntah dengan sengaja."}},{"id":1521182,"tag":"p","type":"paragraph","splitted":1,"split_group":63,"original_text":"\u0648\u0647\u0648 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0645\u0627 \u0641\u064a \u0627\u0644\u0645\u0639\u062f\u0629 \u0645\u0646 \u0637\u0639\u0627\u0645 \u0623\u0648 \u0634\u0631\u0627\u0628 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0641\u0645 \u0645\u062a\u0639\u0645\u062f\u0627\u064b\u060c \u0648\u0623\u0645\u0627 \u0625\u0630\u0627 \u063a\u0644\u0628\u0647 \u0627\u0644\u0642\u064a\u0621 \u0648\u062e\u0631\u062c \u0645\u0646\u0647 \u0628\u063a\u064a\u0631 \u0627\u062e\u062a\u064a\u0627\u0631\u0647 \u0641\u0644\u0627 \u064a\u0624\u062b\u0631 \u0639\u0644\u0649 \u0635\u064a\u0627\u0645\u0647\u061b \u0644\u0642\u0648\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645: \u00ab\u0645\u0646 \u0630\u0631\u0639\u0647 \u0627\u0644\u0642\u064a\u0621 \u0641\u0644\u064a\u0633 \u0639\u0644\u064a\u0647 \u0642\u0636\u0627\u0621\u060c \u0648\u0645\u0646 \u0627\u0633\u062a\u0642\u0627\u0621 \u0641\u0644\u064a\u0642\u0636\u00bb ([15]). \u0648\u0645\u0639\u0646\u0649 \u0630\u0631\u0639\u0647: \u063a\u0644\u0628\u0647.  \u0623\u062e\u0631\u062c\u0647 \u0627\u0644\u0625\u0645\u0627\u0645 \u0623\u062d\u0645\u062f \u0641\u064a \u0645\u0633\u0646\u062f\u0647 \u0628\u0631\u0642\u0645 10463 (16\/283)\u060c \u0648\u0627\u0644\u062a\u0631\u0645\u0630\u064a \u0641\u064a \u0627\u0644\u062c\u0627\u0645\u0639 \u0627\u0644\u0643\u0628\u064a\u0631 \u0628\u0631\u0642\u0645 720 (2\/91).","page_number":7,"transes":{"ur":"\u06cc\u06c1 \u0645\u0639\u062f\u06d2 \u0645\u06cc\u06ba \u0645\u0648\u062c\u0648\u062f \u06a9\u06be\u0627\u0646\u06d2 \u06cc\u0627 \u067e\u0627\u0646\u06cc \u06a9\u0648 \u062c\u0627\u0646 \u0628\u0648\u062c\u06be \u06a9\u0631 \u0645\u0646\u06c1 \u06a9\u06d2 \u0631\u0627\u0633\u062a\u06d2 \u0633\u06d2 \u0646\u06a9\u0627\u0644\u0646\u0627 \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0627\u06af\u0631 \u06a9\u0633\u06cc \u06a9\u0648 \u0628\u0644\u0627 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0642\u06d2 \u0622 \u062c\u0627\u06d3 \u062a\u0648 \u0627\u0633 \u0633\u06d2 \u0627\u0633 \u06a9\u06d2 \u0631\u0648\u0632\u06c1 \u067e\u0631 \u06a9\u0648\u0626\u06cc \u0627\u062b\u0631 \u0646\u06c1\u06cc\u06ba \u067e\u0691\u06d2 \u06af\u0627\u061b \u06a9\u06cc\u0648\u0646\u06a9\u06c1 \u0646\u0628\u06cc \u06a9\u0631\u06cc\u0645 \u0635\u0644\u06cc \u0627\u0644\u0644\u06c1 \u0639\u0644\u06cc\u06c1 \u0648\u0633\u0644\u0645 \u0646\u06d2 \u0641\u0631\u0645\u0627\u06cc\u0627: ''\u062c\u0633\u06d2 \u0642\u06d2 \u0622\u062c\u0627\u06d3 \u0627\u0633 \u067e\u0631 \u0642\u0636\u0627 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2 \u0627\u0648\u0631 \u062c\u0648 \u0642\u06d2 \u06a9\u0631\u06d2 \u0627\u0633 \u067e\u0631 \u0642\u0636\u0627 \u0648\u0627\u062c\u0628 \u06c1\u06d2''\u06d4 ([15]) \u0630\u0631\u0639\u0647 \u06a9\u0627 \u0645\u0639\u0646\u06cc \u06c1\u06d2: \u063a\u0644\u0628\u06c1\u06d4 \u0645\u0633\u0646\u062f \u0627\u062d\u0645\u062f: \u06f1\u06f0\u06f4\u06f6\u06f3 (\u06f1\u06f6\/\u06f2\u06f8\u06f3)\u060c \u062a\u0631\u0645\u0630\u06cc \u06a9\u06cc \u0627\u0644\u062c\u0627\u0645\u0639 \u0627\u0644\u0643\u0628\u064a\u0631: \u06f7\u06f2\u06f0 (\u06f2\/\u06f9\u06f1)\u06d4","id":"Yaitu mengeluarkan makanan atau minuman dari dalam perut melalui mulut dengan sengaja. Namun, jika seseorang muntah tanpa disengaja, maka hal itu tidak membatalkan puasanya. Hal ini berdasarkan sabda Rasulullah \ufdfa, \"Siapa yang muntah tanpa disengaja, maka tidak ada qada baginya. Namun, barang siapa yang muntah dengan sengaja, maka ia harus mengqada puasanya.\"([15]) Makna \"\u017cara'ahu\" dalam hadis ini adalah mengalahkannya. HR. Ahmad dalam Musnad-nya, no. 10463 (16\/283), dan Tirmizi dalam Al-J\u0101mi' Al-Kab\u012br, no. 720 (2\/91)."}}],"meta":{"total_pages":10}}