[{"tr":"Katakanlah, \"Aku berlindung kepada Tuhannya manusia,","fn":""},{"tr":"Raja manusia,","fn":""},{"tr":"sembahan manusia,","fn":""},{"tr":"dari kejahatan (bisikan) setan yang bersembunyi,","fn":""},{"tr":"yang membisikkan (kejahatan) ke dalam dada manusia,","fn":""},{"tr":"dari (golongan) jin dan manusia.\"","fn":""}]