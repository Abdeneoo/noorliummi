[{"tr":"Yüzünü ekşitti ve arkasını döndü.","fn":""},{"tr":"Kendisine o âmâ geldi diye.","fn":""},{"tr":"Ne bilirsin belki o temizlenecekti.","fn":""},{"tr":"Yahut öğüt alacaktı da bu öğüt ona fayda verecekti.","fn":""},{"tr":"Kendini muhtaç hissetmeyene gelince;","fn":""},{"tr":"Sen, ona yöneliyorsun.","fn":""},{"tr":"(İstemiyorsa) arınmamasından sen sorumlu değilsin!","fn":""},{"tr":"Fakat koşup sana gelen kimse;","fn":""},{"tr":"(Allah'tan) korkuğu halde;","fn":""},{"tr":"Sen onu bırakıp oyalanıyorsun.","fn":""},{"tr":"Hayır. Bu ancak bir öğüttür.","fn":""},{"tr":"Artık dileyen kimse ondan öğüt alır.","fn":""},{"tr":"(O) şerefli sahifelerdedir.","fn":""},{"tr":"Yüce ve tertemiz olan.","fn":""},{"tr":"Kâtiplerin ellerinde.","fn":""},{"tr":"Değerli ve itaatkâr olan (Meleklerin).","fn":""},{"tr":"Kahrolası (inkârcı) insan! Ne nankördür o!","fn":""},{"tr":"Allah, onu hangi şeyden yarattı?","fn":""},{"tr":"Bir nutfeden yarattı ve belli bir şekle soktu.","fn":""},{"tr":"Sonra da ona yolu kolaylaştırdı.","fn":""},{"tr":"Sonra da onu öldürüp kabre koydu.","fn":""},{"tr":"Sonra dilediği zaman onu yeniden diriltir.","fn":""},{"tr":"Hayır. O (Rabbinin) kendisine emrettiğini yerine getirmedi.","fn":""},{"tr":"İnsan yiyeceğine bir baksın.","fn":""},{"tr":"Şüphesiz biz suyu/yağmuru döktükçe döktük.","fn":""},{"tr":"Sonra toprağı iyiden iyiye yardık!","fn":""},{"tr":"Ve orada taneler bitirdik.","fn":""},{"tr":"Üzümler ve yoncalar,","fn":""},{"tr":"Zeytinler ve hurmalar,","fn":""},{"tr":"Sık ağaçlı bahçeler,","fn":""},{"tr":"Meyveler ve otlaklar,","fn":""},{"tr":"Sizin ve hayvanlarınızın yararlanması için,","fn":""},{"tr":"Kulakları sağır eden o ses geldiğinde,","fn":""},{"tr":"O gün kişi kardeşinden kaçar.","fn":""},{"tr":"Anasından ve babasından,","fn":""},{"tr":"Eşinden ve evladından,","fn":""},{"tr":"O gün herkes için kendine yetecek bir işi vardır.","fn":""},{"tr":"O gün birtakım yüzler vardır ki pırıl pırıl parlarlar.","fn":""},{"tr":"Güleç ve neşelidir.","fn":""},{"tr":"Öyle yüzler de var ki o gün üzerini toz kaplamıştır.","fn":""},{"tr":"Onları bir siyahlık bürür.","fn":""},{"tr":"İşte onlar kâfirler, facirlerdir.","fn":""}]