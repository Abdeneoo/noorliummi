[{"tr":"Güneş dürüldüğü zaman.","fn":""},{"tr":"Yıldızlar, saçılıp dağıldığı zaman.","fn":""},{"tr":"Dağlar yürütüldüğü zaman.","fn":""},{"tr":"Gebe develer başıboş bırakıldığı zaman.","fn":""},{"tr":"Vahşi hayvanlar bir araya toplandığı zaman.","fn":""},{"tr":"Denizler tutuşturulduğu zaman.","fn":""},{"tr":"Nefisler/kişiler (benzerleriyle) birleştirildiği zaman.","fn":""},{"tr":"Diri diri (toprağa) gömülen kız çocuğuna sorulduğu zaman.","fn":""},{"tr":"\"Hangi günâhtan dolayı öldürüldü?\" (diye).","fn":""},{"tr":"Sahifeler (amel defterleri) açıldığı zaman.","fn":""},{"tr":"Gök, sıyrılıp ayrıldığı zaman.","fn":""},{"tr":"Cehennem alevlendirildiği zaman.","fn":""},{"tr":"Ve Cennet yaklaştırıldığı zaman.","fn":""},{"tr":"Her nefis önceden ne hazırladığını bilecektir.","fn":""},{"tr":"Hayır! Yemin ederim gizlenen (yıldızlara).","fn":""},{"tr":"O akıp akıp yörüngesinde giden ve gizlenenlere.","fn":""},{"tr":"Karardığında geceye.","fn":""},{"tr":"Aydınlanmaya başladığında sabaha.","fn":""},{"tr":"Şüphesiz o, çok değerli bir elçinin sözüdür.","fn":""},{"tr":"Kuvvet sahibi; Arşın sahibinin katında itibarlı (bir elçinin).","fn":""},{"tr":"Kendine itaat edilen, üstelik güvenilir.","fn":""},{"tr":"Arkadaşınız bir mecnun değildir.","fn":""},{"tr":"Onu (Cebrail'i) ufukta apaçık görmüştür.","fn":""},{"tr":"O, gayp hakkında cimri değildir.","fn":""},{"tr":"O, kovulmuş Şeytan'ın sözü de değildir.","fn":""},{"tr":"Öyleyse nereye gidiyorsunuz?","fn":""},{"tr":"O, yalnızca bütün âlemler için bir öğüttür.","fn":""},{"tr":"Sizden dosdoğru olmak isteyenler için.","fn":""},{"tr":"Âlemlerin Rabbi Allah dilemedikçe siz de dileyemezsiniz.","fn":""}]