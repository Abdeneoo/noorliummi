{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start -p 3123",
      "startServerReadyPattern": "Ready in",
      "url": ["http://localhost:3123/", "http://localhost:3123/quran/36", "http://localhost:3123/adhkar/27", "http://localhost:3123/hadith/bukhari/1", "http://localhost:3123/lessons"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "../../reports/lighthouse/ci" }
  }
}
