{
  "manifest_version": 3,
  "name": "نور لأمي — ذكّرني",
  "description": "مواقيت الصلاة والأذان، تذكير الورد والأذكار والصيام، ووضع النوم — من منصة نور لأمي. بلا تتبع ولا جمع بيانات.",
  "version": "1.5.0",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "geolocation",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "نور لأمي — ذكّرني",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
